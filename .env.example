# Copy to .env and fill in. .env is git-ignored.

# Anthropic API key used by the vision-language gates (src/03_04_retrieval_and_cascade/).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hugging Face token, if the Hub requires one for the MapPool shards (src/01_dictionaries).
HF_TOKEN=

# --- Paths to data that is not published with this repository ---

# Working SQLite database written by the pipeline (not published).
STATMAP_DB=pipeline.db

# Stage 1 output: part_*.parquet with scores and embeddings, written by
# src/01_dictionaries/filter_scores.py. Read by Stage 2 and by src/release/.
MAPPOOL_DATA=mappool_parts

# Where downloaded images are cached (tens of GB for a full run).
STATMAP_IMAGE_CACHE=image_cache

# Where src/release/ writes the export packages.
STATMAP_OUT=build/packages

# Location of the Stage 3-4 code, imported by validation/retest/run_retest.py.
STATMAP_PIPELINE_DIR=src/03_04_retrieval_and_cascade
